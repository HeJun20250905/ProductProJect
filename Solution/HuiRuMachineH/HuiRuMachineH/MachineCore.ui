  <property name="styleSheet">
   <string notr="true">/* ================== QPushButton &amp; QToolButton 开始 ================== */

/* 按钮默认状态 */
QPushButton, QToolButton {
    border: 1px solid #c0c0c0;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #e0e0e0);
    border-radius: 3px; 
    outline: none;                  
    padding: 0px;                   
}

/* 按钮鼠标悬停时 */
QPushButton:hover, QToolButton:hover {
    border: 1px solid #a0a0a0;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #d0d0d0);
}

/* 按钮鼠标按下时 */
QPushButton:pressed, QToolButton:pressed {
    border: 1px solid #808080;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d0d0d0, stop:1 #e0e0e0);
}

/* ================== QLineEdit 开始 ================== */

/* 默认状态 */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #D0D0D0;     
    border-radius: 5px;            
    padding: 2px 2px;              
    color: #222222;                
    min-height: 20px;              
}

/* 获得焦点时 */
QLineEdit:focus {
    border: 1px solid #007AFF;     
    background-color: #E8F4FF;     
}

/* 禁用状态 */
QLineEdit:disabled {
    background-color: #eef1f5;     
    color: #9aa0a6;                
    border: 1px solid #d3d8e0;     
}

/* ================== QTableWidget 开始 ================== */

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #c8cdd6;
    border-radius: 1px;
    gridline-color: #eef1f5;
    selection-background-color: #eef1f5;
    color: #222222;
}

QTableWidget::item {
    padding: 2px 2px;
}

/* 表头样式 */
QHeaderView::section {
    background-color: #f7f9fc;         /* 稍微带点蓝灰色的背景，比纯白更有质感 */
    border: none;
    border-bottom: 1px solid #c8cdd6;  /* 底部保留主分割线 */
    border-right: 1px solid #eef1f5;   /* 右侧保留列分割线 */
    padding: 0px 0px;                 /* 增加内边距，让表头看起来不那么拥挤 */
    color: #222222;
    font-weight: bold;                 /* 表头加粗，增强视觉引导 */
    text-align: left;                  /* 强制左对齐（默认可能是居中，左对齐更易读） */
}

/* 鼠标悬停在表头上时的效果 */
QHeaderView::section:hover {
    background-color: #eef1f5;         /* 悬停时背景稍微变深，提供交互反馈 */
}

/* 去掉表头最右侧多余的边框线 */
QHeaderView::section:last {
    border-right: none;
}

/* ================== QGroupBox 开始 ================== */

QGroupBox {
    border: 1px solid #E0E0E0; 
    border-radius: 5px; 
    background-color: #FCFCFC; 
    margin-top: 10px; /* ⚠️ 新增：给标题留出一点顶部空间 */
}

/* 分组框标题（补充了左右内边距） */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #333333;
    font-weight: bold;
    background-color: #FCFCFC; 
    padding: 0 5px; /* ⚠️ 新增：左右留出 5px 空间，让遮盖边框的效果更自然，文字不贴边 */
}

/* ================== QLabel 开始 ================== */

QLabel {
    color: #333333;           /* 与 QGroupBox::title 保持一致的深灰色 */
    font-weight: bold;        /* 保持相同的加粗效果（如果是普通文本可去掉这行） */
    background-color: #FCFCFC; /* 与分组框背景色一致 */
    border: 1px solid #E0E0E0; /* 相同的边框颜色和粗细 */
    border-radius: 5px;       /* 相同的圆角 */
    padding: 6px 10px;        /* 适当的内边距，让文字不贴边，视觉上更舒适 */
}

/* ================== QComboBox 开始 ================== */

/* 默认状态 */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #D0D0D0;     
    border-radius: 3px;            
    padding: 2px 2px;              
    color: #222222;                
    min-height: 20px;
	font-weight: bold;             /* 加上这一行，文字就加粗了 */              
}

/* 获得焦点时 */
QComboBox:focus {
    border: 1px solid #007AFF;     
    background-color: #E8F4FF;     
}

/* 禁用状态 */
QComboBox:disabled {
    background-color: #eef1f5;     
    color: #9aa0a6;                
    border: 1px solid #d3d8e0;     
}

/* 右侧下拉按钮区域 */
QComboBox::drop-down {
    width: 16px;
    border-left: 1px solid #D0D0D0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* 使用自定义图片作为下拉箭头 */
QComboBox::down-arrow {
    image: url(:/MachineCore/Icon/fa_0xf107.png); /* 替换为你的资源路径 */
    width: 10px;                        /* 建议设置合适的宽高 */
    height: 10px;
}

/* QFrame (分割线) */
QFrame[frameShape=&quot;4&quot;], 
QFrame[frameShape=&quot;5&quot;] {
    border: none;              /* 1. 彻底干掉外框，绝不会出现方框 */
    background-color: #D0D0D0; /* 2. 核心！用背景色来充当线条的颜色 */

}
</string>
