  <property name="styleSheet">
   <string notr="true">/* ================== QPushButton &amp; QToolButton 开始 ================== */

/* 按钮默认状态 */
QPushButton, QToolButton {
    border: 1px solid #c0c0c0;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #e0e0e0);
    border-radius: 5px; 
    outline: none;                  
    padding: 0px;                   
}

/* 按钮鼠标悬停时 */
QPushButton:hover, QToolButton:hover {
    border: 1px solid #a0a0a0;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #d0d0d0);
}

/* 按钮鼠标按下时 */
QPushButton:pressed, QToolButton:pressed {
    border: 1px solid #808080;      
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d0d0d0, stop:1 #e0e0e0);
}

/* ================== QLineEdit 开始 ================== */

/* 默认状态 */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #D0D0D0;     
    border-radius: 4px;            
    padding: 2px 2px;              
    color: #222222;                
    min-height: 20px;              
}

/* 获得焦点时 */
QLineEdit:focus {
    border: 1px solid #007AFF;     
    background-color: #E8F4FF;     
}

/* 禁用状态 */
QLineEdit:disabled {
    background-color: #eef1f5;     
    color: #9aa0a6;                
    border: 1px solid #d3d8e0;     
}

/* ================== QTableWidget 开始 ================== */

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #c8cdd6;
    border-radius: 5px;
    gridline-color: #eef1f5;
    selection-background-color: #eef1f5;
    color: #222222;
}

QTableWidget::item {
    padding: 2px 2px;
}

/* 表头样式（补充了右侧分割线） */
QHeaderView::section {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #c8cdd6;
    border-right: 1px solid #eef1f5; /* ⚠️ 新增：给表头加上右侧分割线，区分不同列 */
    padding: 2px 2px;
    color: #222222;
}

/* ================== QGroupBox 开始 ================== */

QGroupBox {
    border: 1px solid #E0E0E0; 
    border-radius: 5px; 
    background-color: #FCFCFC; 
    margin-top: 10px; /* ⚠️ 新增：给标题留出一点顶部空间 */
}

/* 分组框标题（补充了左右内边距） */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #333333;
    font-weight: bold;
    background-color: #FCFCFC; 
    padding: 0 5px; /* ⚠️ 新增：左右留出 5px 空间，让遮盖边框的效果更自然，文字不贴边 */
}

/* ================== QLabel 开始 ================== */

QLabel {
    color: #333333;           /* 与 QGroupBox::title 保持一致的深灰色 */
    font-weight: bold;        /* 保持相同的加粗效果（如果是普通文本可去掉这行） */
    background-color: #FCFCFC; /* 与分组框背景色一致 */
    border: 1px solid #E0E0E0; /* 相同的边框颜色和粗细 */
    border-radius: 5px;       /* 相同的圆角 */
    padding: 6px 10px;        /* 适当的内边距，让文字不贴边，视觉上更舒适 */
}

/* ================== QListWidget 开始 ================== */

/* 列表整体样式：保持与表格一致的背景、边框和圆角 */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #c8cdd6;
    border-radius: 2px;
    color: #222222;
    outline: none; /* ⚠️ 关键：去掉点击列表时默认出现的黑色虚线框 */
}

/* 列表项样式：设置内边距，让文字不要太挤 */
QListWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #eef1f5; /* ⚠️ 新增：用柔和的分割线区分每一行，呼应表头风格 */
}

/* 鼠标悬停时的样式：提供轻微的视觉反馈 */
QListWidget::item:hover {
    background-color: #f8f9fa; 
}

/* 选中状态样式：保持与表格的选中色完全一致 */
QListWidget::item:selected {
    background-color: #eef1f5;
    color: #222222; /* 保持文字颜色不变，避免高亮时看不清 */
}

/* ================== QStackedWidget 开始 ================== */

QStackedWidget {
    background-color: #ffffff;         /* 保持与表格一致的纯白背景 */
    border: 1px solid #c8cdd6;         /* 使用与表格相同的边框颜色和粗细 */
    border-radius: 2px;                /* 保持相同的圆角，视觉风格统一 */
    color: #222222;                    /* 统一字体颜色 */
}

QStackedWidget &gt; QWidget {
    background-color: transparent;     /* 让子页面背景透明，完美继承父容器的白色背景 */
    border: none;                      /* 移除子页面默认可能存在的多余边框 */
    padding: 10px;                     /* 增加内边距，防止内容紧贴边缘（可根据需求调整） */
}</string>
